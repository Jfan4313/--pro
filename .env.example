# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_AUTH_REQUIRED=false
LOCAL_API_AUTH_REQUIRED=false
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8787
LOCAL_DATA_DIR=./data
APP_ORIGIN=http://localhost:3000
INITIAL_ADMIN_PASSWORD=请在正式部署时设置强密码

# 企业微信机器人通知（可选）。在企业微信群中添加机器人后填写 Webhook 地址。
# Webhook 只在服务端使用，不要写入 VITE_ 开头的前端环境变量。
WECOM_WEBHOOK_URL=
# development: show OTP in local login page/log; SMS provider can be wired later
OTP_MODE=development
# 每日未完成/待确认汇总发送时间（服务器本地时间，0-23）
WECOM_DAILY_REMINDER_HOUR=9
# 每日任务总结发送时间（0-23）
WECOM_DAILY_SUMMARY_HOUR=18
# Optional OpenAI-compatible AI task extraction provider. Keep the key server-side.
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# 语音正式识别引擎：funasr 或 doubao。豆包使用云端模型，不在本机加载大模型。
ASR_PROVIDER=funasr
ASR_SERVICE_URL=http://127.0.0.1:8790
ASR_PRIMARY_MODEL=paraformer-zh
ASR_FALLBACK_MODEL=sensevoice-small
ASR_TIMEOUT_MS=90000
# 豆包新版控制台填写 DOUBAO_API_KEY；旧版填写 APP_KEY + ACCESS_KEY。
DOUBAO_API_KEY=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
# 可选：火山引擎控制台创建的热词表 ID。
DOUBAO_HOTWORD_TABLE_ID=
