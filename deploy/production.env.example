NODE_ENV=production
LOCAL_API_HOST=127.0.0.1
LOCAL_API_PORT=8787
LOCAL_API_AUTH_REQUIRED=true
LOCAL_DATA_DIR=/var/lib/zhijian-pro
ASR_SERVICE_URL=http://127.0.0.1:8790
ASR_PRIMARY_MODEL=paraformer-zh
ASR_FALLBACK_MODEL=sensevoice-small
ASR_TIMEOUT_MS=90000
ASR_MAX_AUDIO_BYTES=20971520
# 正式语音引擎：doubao 或 funasr。豆包云端识别不加载本地大模型。
ASR_PROVIDER=doubao
DOUBAO_API_KEY=
DOUBAO_APP_KEY=
DOUBAO_ACCESS_KEY=
DOUBAO_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
DOUBAO_HOTWORD_TABLE_ID=
APP_ORIGIN=https://project.zero-carbon.online
INITIAL_ADMIN_PASSWORD=请替换为至少16位的随机强密码
